# ── PRIMBIO — variables de entorno ──────────────────────────────
# Copiar a `.env` (nunca commitear el `.env` real con el token).
#
# Modo:
#   local  = clonar y usar péndulo propio (puertos/cámara elegibles)
#   remote = PC del laboratorio tras remoteiplab.primbiolab.org (todo fijo)
APP_MODE=remote

# Serial fijo del laboratorio
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=115200
AUTO_CONNECT=true

# Cámara fija del laboratorio (índice OpenCV o URL RTSP/HTTP)
CAMERA_ENABLED=true
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15

REMOTE_LABEL=Laboratorio PRIMBIO — Péndulo remoto

# Token del túnel Cloudflare (Zero Trust → Networks → Tunnels).
# Se obtiene al crear el túnel para remoteiplab.primbiolab.org.
TUNNEL_TOKEN=cambia-este-token